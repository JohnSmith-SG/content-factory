# Скопируй в vps.env и заполни своими значениями. vps.env в git не попадает.

# Адрес сервера автопубликации в формате user@host
VPS_HOST=deploy-user@your.server.ip

# Путь к локальному файлу, где лежит пароль от сервера
# (строка вида "password: ..." в любом месте файла)
VPS_CRED_FILE=/c/Users/you/path/to/credentials.txt
